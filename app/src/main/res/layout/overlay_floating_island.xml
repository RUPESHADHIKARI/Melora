<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Music Island: compact pill + expanded player card in one window.
     The pill wraps the front-camera cutout: artwork left, camera hole in the
     middle (island_pill_gap), waveform right. Backgrounds, tints, gap width
     and artwork corners are applied programmatically. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/island_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/island_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/island_pill_artwork"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/album_art" />

        <Space
            android:id="@+id/island_pill_gap"
            android:layout_width="18dp"
            android:layout_height="1dp" />

        <com.metrolist.music.overlay.WaveformView
            android:id="@+id/island_pill_waveform"
            android:layout_width="28dp"
            android:layout_height="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/island_card"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Content wrapper: faded/scaled separately from the card background
             so the background shape morphs continuously without ghosting. -->
        <LinearLayout
            android:id="@+id/island_card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/island_card_artwork"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/album_art" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/island_card_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MELORA"
                        android:textColor="#99FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.25" />

                    <TextView
                        android:id="@+id/island_card_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/island_card_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/island_btn_shuffle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="12dp"
                    android:src="@drawable/shuffle"
                    android:contentDescription="@string/shuffle" />

                <ImageView
                    android:id="@+id/island_btn_prev"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="12dp"
                    android:src="@drawable/skip_previous"
                    android:contentDescription="@string/previous" />

                <ImageView
                    android:id="@+id/island_btn_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="12dp"
                    android:src="@drawable/pause"
                    android:contentDescription="@string/play_pause" />

                <ImageView
                    android:id="@+id/island_btn_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="12dp"
                    android:src="@drawable/skip_next"
                    android:contentDescription="@string/next" />

                <ImageView
                    android:id="@+id/island_btn_like"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="12dp"
                    android:src="@drawable/favorite_border"
                    android:contentDescription="@string/like" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
